{% extends "layout/page_without_tabs.html.twig" %}

{% block content_title %}
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <h1 class="mb-0">{{ title|default('BookStack knowledge')|e }}</h1>
    {% if canConfigure|default(false) %}<a class="btn btn-outline-secondary" href="{{ path('/plugins/bookstackbridge/') }}">{{ __('Connection settings', 'bookstackbridge')|e }}</a>{% endif %}
  </div>
{% endblock %}

{% block content_body %}
  <nav aria-label="{{ __('Breadcrumb', 'bookstackbridge')|e }}" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="{{ path('/plugins/bookstackbridge/knowledge') }}">{{ __('Shelves', 'bookstackbridge')|e }}</a></li>
      {% for crumb in breadcrumbs|default([]) %}
        <li class="breadcrumb-item"><a href="{{ path(crumb.href) }}">{{ crumb.label|e }}</a></li>
      {% endfor %}
      {% if view not in ['shelves', 'error'] %}<li class="breadcrumb-item active" aria-current="page">{{ title|e }}</li>{% endif %}
    </ol>
  </nav>

  {% if error %}
    <div class="alert alert-danger" role="alert">{{ error|e }}</div>
    <p><a class="btn btn-outline-secondary" href="{{ path('/plugins/bookstackbridge/knowledge') }}">{{ __('Back to shelves', 'bookstackbridge')|e }}</a></p>
  {% elseif notice %}
    <div class="alert alert-info" role="status">{{ notice|e }}</div>
  {% elseif view == 'page' %}
    <section class="card">
      <div class="card-body">
        <h2 class="h3">{{ page.name|e }}</h2>
        <p class="text-muted mb-0">{{ __('Page text, images, and attachments will be available in the next reader milestone.', 'bookstackbridge')|e }}</p>
      </div>
    </section>
  {% elseif view == 'book' and shelves is defined and shelves is not empty %}
    <p class="text-muted">{{ __('Shelves containing this book:', 'bookstackbridge')|e }}
      {% for shelf in shelves %}<a href="{{ path(shelf.href) }}">{{ shelf.name|e }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
    </p>
  {% endif %}

  {% if view in ['shelves', 'shelf', 'book', 'chapter'] %}
    {% if items is empty %}
      <div class="alert alert-info" role="status">{{ __('No items are available here.', 'bookstackbridge')|e }}</div>
    {% else %}
      <div class="list-group">
        {% for item in items %}
          <a class="list-group-item list-group-item-action" href="{{ path(item.href) }}">
            <span class="fw-semibold">{{ item.name|e }}</span>
            {% if item.type is defined %}<span class="badge bg-secondary ms-2">{{ (item.type == 'chapter' ? __('Chapter', 'bookstackbridge') : __('Page', 'bookstackbridge'))|e }}</span>{% endif %}
            {% if item.description is defined and item.description %}<span class="d-block text-muted small mt-1">{{ item.description|e }}</span>{% endif %}
          </a>
        {% endfor %}
      </div>
    {% endif %}
  {% endif %}

  {% if pagination is defined and pagination.pages > 1 %}
    <nav class="mt-3" aria-label="{{ __('Shelf pages', 'bookstackbridge')|e }}">
      <ul class="pagination">
        {% if pagination.page > 1 %}<li class="page-item"><a class="page-link" href="{{ path('/plugins/bookstackbridge/knowledge?page=' ~ (pagination.page - 1)) }}">{{ __('Previous', 'bookstackbridge')|e }}</a></li>{% endif %}
        <li class="page-item disabled"><span class="page-link">{{ pagination.page }} / {{ pagination.pages }}</span></li>
        {% if pagination.page < pagination.pages %}<li class="page-item"><a class="page-link" href="{{ path('/plugins/bookstackbridge/knowledge?page=' ~ (pagination.page + 1)) }}">{{ __('Next', 'bookstackbridge')|e }}</a></li>{% endif %}
      </ul>
    </nav>
  {% endif %}

  {% if view not in ['shelves', 'error'] %}
    {% if view == 'shelf' or view == 'book' %}
      {% set backHref = '/plugins/bookstackbridge/knowledge' %}
    {% elseif view == 'chapter' %}
      {% set backHref = breadcrumbs[0].href %}
    {% else %}
      {% set lastCrumb = breadcrumbs|last %}
      {% set backHref = lastCrumb.href|default('/plugins/bookstackbridge/knowledge') %}
    {% endif %}
    <p class="mt-3"><a class="btn btn-outline-secondary" href="{{ path(backHref) }}">{{ __('Back', 'bookstackbridge')|e }}</a></p>
  {% endif %}
{% endblock %}
